# Copy this file to .env and fill in real values. Never commit the .env file itself.

GEMINI_API_KEY=your-gemini-api-key-here

# Only used by web_quiz.py. Any random string works; used to sign Flask session cookies.
FLASK_SECRET_KEY=change-this-to-a-random-string

# Optional, defaults shown
PORT=5000
FLASK_DEBUG=0
